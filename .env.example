# AquaMind Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==========================================
# Application
# ==========================================
APP_NAME=AquaMind
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
API_PREFIX=/api/v1

# ==========================================
# Database (PostgreSQL 18)
# ==========================================
DATABASE_URL=postgresql+psycopg://aquamind:YOUR_REAL_PASSWORD@localhost:5432/aquamind
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ==========================================
# Authentication & Authorization
# ==========================================
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@aquamind.local
ADMIN_PASSWORD=change-this-password-on-first-login

# ==========================================
# Raspberry Pi Hardware
# ==========================================
# Set to 'simulator' for development, 'hardware' for Raspberry Pi
HARDWARE_MODE=simulator
RASPBERRY_PI_HOST=localhost
RASPBERRY_PI_PORT=8080

# GPIO Pin Configuration (BCM numbering)
GPIO_PH_SENSOR=4
GPIO_TEMPERATURE_SENSOR=17
GPIO_TDS_SENSOR=27
GPIO_WATER_LEVEL_SENSOR=22
GPIO_AIR_TEMP_SENSOR=23
GPIO_HUMIDITY_SENSOR=24
GPIO_FISH_FEEDER=18
GPIO_WATER_PUMP=19
GPIO_OXYGEN_PUMP=20
GPIO_INTAKE_FAN=21
GPIO_EXHAUST_FAN=25
GPIO_RESERVOIR_REFILL=26

# Sensor I2C Addresses (if applicable)
PH_SENSOR_I2C_ADDR=0x63
TDS_SENSOR_I2C_ADDR=0x48

# ==========================================
# Sensor Calibration
# ==========================================
PH_CALIBRATION_OFFSET=0.0
TDS_CALIBRATION_FACTOR=1.0
WATER_TEMP_CALIBRATION_OFFSET=0.0
AIR_TEMP_CALIBRATION_OFFSET=0.0
HUMIDITY_CALIBRATION_OFFSET=0.0
WATER_LEVEL_CALIBRATION_OFFSET=0.0

# ==========================================
# Fish Feeder Configuration
# ==========================================
FEEDER_DISPENSE_RATE_GRAMS_PER_SECOND=0.5
FEEDER_CALIBRATION_RUNS=3
DEFAULT_FISH_POPULATION=50
DEFAULT_FISH_WEIGHT_GRAMS=100
FEEDING_FREQUENCY_PER_DAY=2
FEEDING_PERCENTAGE_OF_BODY_WEIGHT=1.5

# ==========================================
# Water Level Thresholds (percentage)
# ==========================================
WATER_LEVEL_CRITICAL_LOW=15
WATER_LEVEL_WARNING_LOW=25
WATER_LEVEL_OPTIMAL_MIN=40
WATER_LEVEL_OPTIMAL_MAX=80
WATER_LEVEL_CRITICAL_HIGH=95

# ==========================================
# Environmental Thresholds
# ==========================================
PH_MIN=6.5
PH_MAX=7.5
PH_CRITICAL_MIN=6.0
PH_CRITICAL_MAX=8.0

WATER_TEMP_MIN=20
WATER_TEMP_MAX=28
WATER_TEMP_CRITICAL_MIN=15
WATER_TEMP_CRITICAL_MAX=32

AIR_TEMP_MIN=18
AIR_TEMP_MAX=30
AIR_TEMP_CRITICAL_MIN=15
AIR_TEMP_CRITICAL_MAX=35

HUMIDITY_MIN=40
HUMIDITY_MAX=80
HUMIDITY_CRITICAL_MIN=30
HUMIDITY_CRITICAL_MAX=90

TDS_MIN=400
TDS_MAX=800
TDS_CRITICAL_MAX=1200

# ==========================================
# Automation Timing
# ==========================================
SENSOR_READ_INTERVAL_SECONDS=10
ACTUATOR_CHECK_INTERVAL_SECONDS=5
FEEDING_CHECK_INTERVAL_MINUTES=1
WATER_LEVEL_CHECK_INTERVAL_SECONDS=30
ALERT_CHECK_INTERVAL_SECONDS=60

# ==========================================
# Alert Configuration
# ==========================================
ALERT_COOLDOWN_MINUTES=15
ALERT_RETENTION_DAYS=30
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENTS=

# ==========================================
# WebSocket / Real-time
# ==========================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=1048576

# ==========================================
# Frontend
# ==========================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_TITLE=AquaMind

# Optional ESP32 USB serial receiver (no device token, no Wi-Fi)
# The ESP32 is plugged into the Raspberry Pi via USB.
ESP32_SERIAL_ENABLED=true
ESP32_SERIAL_PORT=/dev/ttyUSB0
ESP32_SERIAL_BAUDRATE=115200
ESP32_DEVICE_ID=esp32-devkit-01
ESP32_SYSTEM_ID=
