# ============================================================
# AQUAMIND
# RASPBERRY PI 5 4GB HARDWARE DEPLOYMENT
# ============================================================


# ============================================================
# HARDWARE ENABLEMENT
# ============================================================
#
# IMPORTANT:
#
# Keep disabled until:
#
# - final relay module is confirmed
# - relay polarity is confirmed
# - actual GPIO wiring is confirmed
# - device electrical ratings are confirmed
# - allowed BCM pins are finalized
# - bench testing has been completed
#
# ============================================================

HARDWARE_ENABLED=false


# ============================================================
# GPIO CONTROLLER
# ============================================================
#
# Will be verified directly on the Raspberry Pi 5 during
# commissioning.
#
# Do not guess this value now.
# ============================================================

HARDWARE_GPIO_CHIP=


# ============================================================
# ALLOWED BCM GPIO PINS
# ============================================================
#
# Empty intentionally.
#
# We will populate this only after the real wiring diagram
# exists.
#
# BCM numbering will be used, not physical header numbering.
# ============================================================

HARDWARE_ALLOWED_BCM_PINS=


# ============================================================
# RELAY CHANNEL CONFIGURATION
# ============================================================
#
# Empty intentionally.
#
# Final entries will be added once we know:
#
# - relay module behavior
# - actual GPIO assignments
# - device-to-relay mapping
# - active-high / active-low polarity
#
# ============================================================

HARDWARE_RELAY_CHANNELS_JSON=[]