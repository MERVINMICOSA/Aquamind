# ============================================================
# AQUAMIND APPLICATION RUNTIME
# ============================================================
#
# API_BIND_HOST controls network exposure.
#
# Pi-only:
#     API_BIND_HOST=127.0.0.1
#
# LAN-accessible:
#     API_BIND_HOST=0.0.0.0
#
# 0.0.0.0 also remains accessible locally from the Pi.
#
# Keep loopback as the safer default until the Raspberry Pi
# network deployment is ready.
# ============================================================

API_BIND_HOST=127.0.0.1
API_BIND_PORT=8000